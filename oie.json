{
    "schemaVersion": 1,
    "id": "sentinel",
    "name": "OIE 哨兵",
    "description": "借鉴 Zabbix 的通道活动监控与告警：不活动、低流量、异常、连接状态、错误率和队列深度监控器，支持邮件、通道、SNS 和 Webhook 告警投递，风暴控制、升级链，以及嵌入 OIE Web 管理员的仪表盘。",
    "type": "plugin",
    "ui": ["web"],
    "version": "1.1.2",
    "minEngineVersion": "4.6.0",
    "maxEngineVersion": "4.6.0",
    "filename": "sentinel-{version}.zip",
    "restartRequired": true,
    "homepage": "https://github.com/gibson9583/oie-sentinel",
    "documentation": "https://github.com/gibson9583/oie-sentinel#readme",
    "license": "MPL-2.0",
    "authors": [
        "Chris Gibson"
    ],
    "keywords": [
        "monitoring",
        "alerting",
        "dashboard",
        "zabbix",
        "channel-activity",
        "anomaly-detection"
    ],
    "deprecated": false
}
